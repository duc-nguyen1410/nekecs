<?xml version="1.0" encoding="utf-8"?>
<!--
  Continuation of the shedding periodic orbit in Re, from the converged
  Re = 100 orbit (po_po.fld, from po.xml) down towards the Hopf point,
  where the orbit shrinks onto the steady wake. Unknowns per point
  x = (u_n, u_{n-1}, T); the phase condition moves with the branch.
  Output: cont_po_branch.dat, cont_po_c<NNN>.fld.
-->
<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">
    <EXPANSIONS>
        <E COMPOSITE="C[0-1]" NUMMODES="6" FIELDS="u,v,p" TYPE="MODIFIED"/>
    </EXPANSIONS>
    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="SolverType" VALUE="VelocityCorrectionScheme"/>
            <I PROPERTY="EQTYPE" VALUE="UnsteadyNavierStokes"/>
            <I PROPERTY="Projection" VALUE="Galerkin"/>
            <I PROPERTY="EvolutionOperator" VALUE="Nonlinear"/>
            <I PROPERTY="ECS_ContParam" VALUE="Re"/>
        </SOLVERINFO>
        <TIMEINTEGRATIONSCHEME>
            <METHOD> IMEX </METHOD>
            <ORDER> 2 </ORDER>
        </TIMEINTEGRATIONSCHEME>
        <PARAMETERS>
            <P> TimeStep      = 0.01      </P>
            <P> NumSteps      = 100       </P>
            <P> IO_InfoSteps  = 1000000   </P>
            <P> Re            = 100.0     </P>
            <P> Kinvis        = 1.0/Re    </P>
            <!-- nekecs -->
            <P> ECS_Steps = 600 </P>
            <P> ECS_Period = 5.98417083 </P>
            <P> ECS_Tol = 1e-9 </P>
            <P> ECS_MaxNewton = 15 </P>
            <P> ECS_MaxKrylov = 60        </P>
            <P> ECS_GmresTol  = 1e-3      </P>
            <P> ECS_Verify = 2 </P>
            <!-- stability of the converged state (0 = off) -->
            <P> ECS_Eigs = 0 </P>
            <P> ECS_EigMaxDim = 60 </P>
            <P> ECS_EigTol    = 1e-4      </P>
            <!-- continuation: Re 100 -> 50 -->
            <P> ECS_ContEnd   = 50        </P>
            <P> ECS_ContDmu   = -2.5      </P>
            <P> ECS_ContDs    = 5         </P>
            <P> ECS_ContDsMax = 10        </P>
            <P> ECS_ContSteps = 40        </P>
        </PARAMETERS>
        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> p </V>
        </VARIABLES>
        <BOUNDARYREGIONS>
            <B ID="0"> C[2] </B> <!-- cylinder wall -->
            <B ID="1"> C[3] </B> <!-- far field -->
            <B ID="2"> C[4] </B> <!-- outlet -->
        </BOUNDARYREGIONS>
        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" VALUE="0"/>
                <D VAR="v" VALUE="0"/>
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0"/>
            </REGION>
            <REGION REF="1">
                <D VAR="u" VALUE="1"/>
                <D VAR="v" VALUE="0"/>
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0"/>
            </REGION>
            <REGION REF="2">
                <N VAR="u" VALUE="0"/>
                <N VAR="v" VALUE="0"/>
                <D VAR="p" VALUE="0"/>
            </REGION>
        </BOUNDARYCONDITIONS>
        <FUNCTION NAME="InitialConditions">
            <F VAR="u,v,p" FILE="po_po.fld"/>
        </FUNCTION>
    </CONDITIONS>
</NEKTAR>
